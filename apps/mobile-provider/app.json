{
  "expo": {
    "name": "ConstruConnect Prestador",
    "slug": "construconnect-provider",
    "version": "1.0.0",
    "scheme": "construconnect-provider",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E2A38"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.orionsystem.construconnect.provider",
      "config": {
        "googleMapsApiKey": "AIzaSyBBUwl-6dPEsrgQG_bCP4esUyLSaStLXr0"
      }
    },
    "android": {
      "package": "com.orionsystem.construconnect.provider",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E2A38"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "GOOGLE_MAPS_KEY_HERE"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1E2A38",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Acesse suas fotos para enviar evidências do serviço.",
          "cameraPermission": "Use a câmera para tirar fotos das obras."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1b3e185e-b981-4aab-b3e3-aa9bd86b30f1"
      }
    }
  }
}
