{
  "expo": {
    "name": "ConstruConnect Cliente",
    "slug": "construconnect-client",
    "version": "1.0.0",
    "scheme": "construconnect-client",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF6B35"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.orionsystem.construconnect.client",
      "config": {
        "googleMapsApiKey": "AIzaSyBBUwl-6dPEsrgQG_bCP4esUyLSaStLXr0"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.orionsystem.construconnect.client",
      "googleServicesFile": "./google-services-client.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B35"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBBUwl-6dPEsrgQG_bCP4esUyLSaStLXr0"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF6B35",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Acesse suas fotos para enviar evidências do serviço.",
          "cameraPermission": "Use a câmera para tirar fotos das obras."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O app usa o microfone para transcrever a descrição do serviço por voz.",
          "speechRecognitionPermission": "O app usa reconhecimento de voz para facilitar a descrição do serviço."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "de270f5f-49c3-46c3-a10f-3cafac51b5c3"
      }
    }
  }
}
