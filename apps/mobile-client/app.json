{
  "expo": {
    "name": "ConstruConnect Cliente",
    "slug": "construconnect-client",
    "version": "1.0.0",
    "scheme": "construconnect-client",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF6B35"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.orionsystem.construconnect.client",
      "config": {
        "googleMapsApiKey": "GOOGLE_MAPS_KEY_HERE"
      }
    },
    "android": {
      "package": "com.orionsystem.construconnect.client",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B35"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "GOOGLE_MAPS_KEY_HERE"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF6B35",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Acesse suas fotos para enviar evidências do serviço.",
          "cameraPermission": "Use a câmera para tirar fotos das obras."
        }
      ]
    ]
  }
}
