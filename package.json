{
  "name": "construconnect-poc",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/patch-metro-runtime.js",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm --workspace apps/web run build",
    "build:api": "npm --workspace apps/api run build",
    "typecheck": "npm --workspace apps/web run typecheck && npm --workspace apps/api run typecheck",
    "deploy:api": "npm --workspace apps/api run deploy",
    "deploy:web": "npm --workspace apps/web run deploy",
    "deploy": "npm run deploy:api && npm run deploy:web",
    "test:e2e": "npm --workspace apps/mobile-client run test:e2e",
    "test:perf": "npm --workspace apps/api run test:perf",
    "test": "npm run test:e2e && npm run test:perf",
    "deploy:staging": "bash scripts/deploy-staging.sh",
    "deploy:production": "bash scripts/deploy-production.sh"
  },
  "devDependencies": {
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "^54.0.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  }
}
